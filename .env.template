# Run forge-rag init-env to create random, separate backend keys. No usable default.
DELEGATION_KEYS={"forge-fastapi":"<Base64 32 random bytes>","forge-spring":"<different Base64 32 random bytes>"}
DELEGATION_AUDIENCE=modular-forge-rag
ENVIRONMENT=development
DATABASE_URL=sqlite:///./data/rag.db
POSTGRES_PASSWORD=<generated by init-env for local Compose>
ALLOWED_HOSTS=["localhost","127.0.0.1"]

# Offline defaults. Live models are explicit operator choices, never auto-selected.
EMBEDDING_PROVIDER=hash
EMBEDDING_MODEL=
EMBEDDING_REVISION=1
EMBEDDING_DIMENSIONS=256
GENERATION_PROVIDER=extractive
GENERATION_MODEL=
OPENAI_API_KEY=
OLLAMA_URL=http://127.0.0.1:11434
PROVIDER_TIMEOUT_SECONDS=30

MODULE_INGESTION_ENABLED=true
MODULE_PDF_ENABLED=false
MODULE_RERANKING_ENABLED=false
MODULE_EVALUATION_ENABLED=true
MODULE_TELEMETRY_ENABLED=true
MODULE_API_DOCS_ENABLED=true
CHUNK_CHARS=1000
CHUNK_OVERLAP=120
MAX_DOCUMENT_BYTES=1000000
MAX_CHUNKS=256
MAX_CONTEXT_CHARS=8000
MIN_SIMILARITY=0.3
CANDIDATE_LIMIT=50
SQLITE_MAX_CHUNKS=10000
JOB_LEASE_SECONDS=300
JOB_MAX_ATTEMPTS=3
